{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vitals.local/schemas/app-index-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_schema_version",
        "source_id",
        "catalog_sequence",
        "trust_sequence",
        "published_at_ms",
        "expires_at_ms",
        "entries"
      ],
      "properties": {
        "index_schema_version": {
          "const": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "catalog_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "trust_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "entries": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "https://agent-vitals.local/schemas/app-release-v1.json"
          }
        },
        "published_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}(?![\\s\\S])"
        }
      }
    }
  }
}
