{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vitals.local/schemas/catalog-index-v1.json",
  "title": "Catalog index v1 (pure validation; activation requires installed slot handlers)",
  "type": "object", "additionalProperties": false,
  "required": ["index_schema_version", "catalog_sequence", "published_at", "entries"],
  "properties": {
    "index_schema_version": {"const": 1},
    "catalog_sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "published_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])", "$comment": "Runtime additionally validates Gregorian calendar dates and hour/minute/second bounds; leap seconds are rejected."},
    "entries": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "slot": {"enum": ["harness_manifest", "price_card", "model_alias", "endpoint_pattern", "trust_profile", "error_taxonomy", "behavior_patterns", "subscription_scope", "fx_reference", "quota_window", "duration_threshold", "slow_call_threshold", "attribution_signatures"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(?![\\s\\S])"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})\\.(0|[1-9][0-9]{0,9})(?![\\s\\S])", "not": {"pattern": "(^|\\.)([5-9][0-9]{9}|4[3-9][0-9]{8}|429[5-9][0-9]{6}|42949[7-9][0-9]{4}|429496[8-9][0-9]{3}|4294967[3-9][0-9]{2}|429496729[6-9])(\\.|$)"}, "$comment": "Each release version component is u32; prerelease/build metadata are not supported in v1."},
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_type", "slot_id", "revision", "sha256"],
      "properties": {"slot_type": {"$ref": "#/$defs/slot"}, "slot_id": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/revision"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_type", "slot_id", "revision", "payload_path", "sha256", "schema_version", "requires", "min_app_version", "display", "dependencies"],
      "properties": {
        "slot_type": {"$ref": "#/$defs/slot"}, "slot_id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/revision"}, "sha256": {"$ref": "#/$defs/sha256"},
        "payload_path": {"type": "string", "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*//)[A-Za-z0-9_./-]+(?<!/)(?![\\s\\S])"},
        "schema_version": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "requires": {"type": "object", "additionalProperties": false, "required": ["recipes", "features"], "properties": {"recipes": {"$ref": "#/$defs/capabilities"}, "features": {"$ref": "#/$defs/capabilities"}}},
        "min_app_version": {"$ref": "#/$defs/version"},
        "display": {"type": "string", "minLength": 1, "maxLength": 256},
        "dependencies": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/dependency"}}
      }
    }
  }
}
