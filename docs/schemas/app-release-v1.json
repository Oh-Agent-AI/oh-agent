{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-vitals.local/schemas/app-release-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_schema_version",
        "source_id",
        "release_sequence",
        "manifest",
        "manifest_sha256",
        "archive"
      ],
      "properties": {
        "release_schema_version": {
          "const": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "release_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "manifest": {
          "$ref": "https://agent-vitals.local/schemas/app-manifest-v1.json"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "url",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "format": {
              "const": "zip"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^https://"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}(?![\\s\\S])"
        }
      }
    }
  }
}
