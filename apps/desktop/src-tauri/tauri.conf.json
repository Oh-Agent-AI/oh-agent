{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oh Agent",
  "mainBinaryName": "agent-vitals-menubar",
  "version": "1.0.0-beta.4",
  "identifier": "ai.ohagent.desktop",
  "build": {
    "frontendDist": "ui-react-dist",
    "beforeBuildCommand": "node ../../scripts/prepare-desktop-bundle.mjs",
    "beforeDevCommand": "npm --prefix ui-dev run dev:react",
    "devUrl": "http://127.0.0.1:5174/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "workbench",
        "title": "Oh Agent 工作台",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "backgroundColor": "#FAFAFA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "../../../target/release/agent-vitals": "bin/agent-vitals"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    }
  }
}
