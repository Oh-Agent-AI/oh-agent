            "counters": {
              "next": {
                "initial": 0,
                "max": 3
              }
            },
            "nodes": [
              {
                "id": "start-timer",
                "on": {
                  "type": "run.started"
                },
                "actions": [
                  {
                    "op": "timer.start",
                    "timerId": "timeout",
                    "durationTicks": {
                      "parameter": "timeLimitTicks"
                    }
                  }
                ]
              },
              {
                "id": "advance",
                "on": {
                  "type": "zone.entered",
                  "slot": "gates"
                },
                "when": [
                  {
                    "op": "counter.eqEventIndex",
                    "counter": "next"
                  }
                ],
                "actions": [
                  {
                    "op": "counter.add",
                    "counter": "next",
                    "amount": 1
                  }
                ]
              },
              {
                "id": "finish",
                "on": {
                  "type": "zone.entered",
                  "slot": "gates"
                },
                "when": [
                  {
                    "op": "counter.eq",
                    "counter": "next",
                    "value": 3
                  }
                ],
                "actions": [
                  {
                    "op": "run.finish",
                    "outcome": "success"
                  }
                ]
              },
              {
                "id": "timeout",
                "on": {
                  "type": "timer.expired",
                  "timerId": "timeout"
                },
                "actions": [
                  {
                    "op": "run.finish",
                    "outcome": "failure"
                  }
                ]
              }
            ]
          }
        }
      },
