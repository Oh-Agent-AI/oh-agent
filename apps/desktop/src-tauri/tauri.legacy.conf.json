{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "npm --prefix ui-dev run dev",
    "devUrl": "http://127.0.0.1:5173/workbench.html"
  },
  "app": {
    "windows": [
      {
        "label": "workbench",
        "title": "Oh Agent 工作台（兼容界面）",
        "url": "workbench.html",
        "width": 760,
        "height": 560,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false
      }
    ]
  }
}
