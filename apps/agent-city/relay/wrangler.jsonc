{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-city-mecha-relay",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "routes": [{ "pattern": "relay.ohagent.ai", "custom_domain": true }],
  "assets": { "directory": "../ui/dist", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "MATCH_ROOM", "class_name": "MatchRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }]
}
