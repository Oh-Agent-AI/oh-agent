{
  "ruleFamily": "mount",
  "case": "mount.invalid-layout-ref-id",
  "expectTs": "error:layout_ref_mismatch",
  "rustNote": "Rust 同样拒绝：layout 引用 id 必须 == cityLayout.layout.id → creator_mount_layout_mismatch；两侧 id 绑定一致（Rust 同时校验 digest==worldRevision，TS 由 resolvedRefs 承担）。待 Rust 运行时验证。",
  "input": {
    "layout": {
      "schemaVersion": 1,
      "id": "loop-layout",
      "coordinateSystem": "city-local-m-v1",
      "anchors": [
        {
          "id": "spawn-a",
          "kind": "spawn",
          "capabilities": [
            "drive",
            "walk"
          ],
          "geometryRef": "geom-spawn-a"
        },
        {
          "id": "zone-b",
          "kind": "zone",
          "capabilities": [
            "drive",
            "walk"
          ],
          "geometryRef": "geom-zone-b"
        },
        {
          "id": "route-c",
          "kind": "route",
          "capabilities": [
            "drive"
          ],
          "geometryRef": "geom-route-c"
        },
        {
          "id": "pad-d",
          "kind": "object",
          "capabilities": [
            "drive"
          ],
          "geometryRef": "geom-pad-d"
        }
      ],
      "links": [
        {
          "id": "link-1",
          "fromAnchorId": "spawn-a",
          "toAnchorId": "zone-b",
          "capabilities": [
            "drive",
            "walk"
          ]
        },
        {
          "id": "link-2",
          "fromAnchorId": "zone-b",
          "toAnchorId": "route-c",
          "capabilities": [
            "drive"
          ]
        },
        {
          "id": "link-3",
          "fromAnchorId": "spawn-a",
          "toAnchorId": "pad-d",
          "capabilities": [
            "drive"
          ]
        }
      ]
    },
    "game": {
      "schemaVersion": 1,
      "id": "loop-sprint",
      "rulesVersion": 1,
      "slots": {
        "gates": {
          "kind": "zone",
          "min": 1,
          "max": 2,
          "requires": [
            "drive"
          ]
        },
        "waypoints": {
          "kind": "route",
          "min": 1,
          "max": 4
        }
      },
      "integerParameters": {
        "laps": {
          "min": 1,
          "max": 3,
          "default": 2
        }
      },
      "rules": {
        "counters": {
          "done": {
            "initial": 0,
            "max": 99
          }
        },
        "nodes": [
          {
            "id": "on-start",
            "on": {
              "type": "run.started"
            },
            "actions": [
              {
                "op": "timer.start",
                "timerId": "countdown",
                "durationTicks": {
                  "parameter": "laps"
                }
              },
              {
                "op": "hud.hint",
                "text": "Reach the gate then finish the loop."
              }
            ]
          },
          {
            "id": "on-gate",
            "on": {
              "type": "zone.entered",
              "slot": "gates"
            },
            "when": [
              {
                "op": "counter.eqEventIndex",
                "counter": "done"
              }
            ],
            "actions": [
              {
                "op": "counter.add",
                "counter": "done",
                "amount": 1
              }
            ]
          },
          {
            "id": "on-lap",
            "on": {
              "type": "zone.entered",
              "slot": "gates"
            },
            "when": [
              {
                "op": "counter.eq",
                "counter": "done",
                "value": 2
              }
            ],
            "actions": [
              {
                "op": "run.finish",
                "outcome": "success"
              }
            ]
          }
        ]
      }
    },
    "mount": {
      "schemaVersion": 1,
      "mountId": "loop-mount-01",
      "layout": {
        "kind": "city-layout",
        "id": "ghost-layout",
        "version": "1.0.0",
        "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "game": {
        "kind": "city-minigame",
        "id": "loop-sprint",
        "version": "1.0.0",
        "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "entryAnchorId": "spawn-a",
      "bindings": {
        "gates": [
          "zone-b"
        ],
        "waypoints": [
          "route-c"
        ]
      },
      "parameterOverrides": {
        "laps": 2
      }
    }
  }
}
