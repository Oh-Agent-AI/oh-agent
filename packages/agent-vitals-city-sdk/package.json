{
  "name": "@agent-vitals/city-sdk",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "bin": {
    "oh-agent-sdk": "./bin/oh-agent-sdk.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/types/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build && node --experimental-transform-types --import ../../scripts/mecha-ts-register.mjs --test tests/*.test.ts",
    "verify:contracts": "node --experimental-transform-types --import ../../scripts/mecha-ts-register.mjs --test tests/contracts.test.ts",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "7.0.2"
  }
}
